POSTGRES_USER=caudales
POSTGRES_PASSWORD=caudales
POSTGRES_DB=caudales
ADMIN_PASSWORD=change-me

# Document assistant (RAG). Provider: bedrock (default) | openai
RAG__PROVIDER=bedrock
# Bedrock: default AWS credential chain (profile locally, instance role on EC2).
AWS_REGION=us-east-1
# RAG__BEDROCKEMBEDDINGMODEL=cohere.embed-multilingual-v3
# RAG__BEDROCKCHATMODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# OpenAI direct (only when RAG__PROVIDER=openai)
OPENAI_API_KEY=
# RAG__OPENAIEMBEDDINGMODEL=text-embedding-3-small
# RAG__OPENAICHATMODEL=gpt-4o-mini
# Retrieval and limits
# RAG__CORPUSROOTS=docs/informes,docs/corpus
# RAG__TOPK=6
# RAG__MINSCORE=0.35
# RAG__RATELIMITPERMINUTE=10
# RAG__SESSIONTTLMINUTES=120
# RAG__MAXUPLOADBYTES=10485760

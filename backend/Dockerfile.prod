# Production: publish with the SDK, run on the lean ASP.NET runtime.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY CaudalesPlatform.Api.csproj ./
RUN dotnet restore CaudalesPlatform.Api.csproj
COPY . ./
RUN dotnet publish CaudalesPlatform.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app ./
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "CaudalesPlatform.Api.dll"]
